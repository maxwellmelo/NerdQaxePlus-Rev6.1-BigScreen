# Apply after sdkconfig.defaults for the YYSLUPING 32 MB trial build.
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_yysluping_32mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_yysluping_32mb.csv"
CONFIG_SPI_FLASH_OVERRIDE_CHIP_DRIVER_LIST=y
